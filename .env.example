# Database
# For Render, this is automatically set via the environment and connected to your PostgreSQL instance
DATABASE_URL="postgresql://user:password@host:5432/civicvoice"

# JWT Secret - CHANGE THIS IN PRODUCTION!
# Generate a strong secret using: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# CORS Origins - comma-separated list of allowed origins
# Examples: "https://civicvoice.com,https://www.civicvoice.com,http://localhost:3000"
# Set to "*" to allow all origins (not recommended for production)
ALLOWED_ORIGINS="*"

# Port - Render will automatically set this to 3000
PORT=3000

# Node Environment
NODE_ENV="production"
